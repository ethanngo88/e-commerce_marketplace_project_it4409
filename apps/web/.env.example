# Sao chép thành .env.local (docs/09_Deployment_Guide.md mục 3).

# URL backend mà trình duyệt gọi. Biến NEXT_PUBLIC_ được nhúng vào mã phía trình duyệt
# lúc build, nên không đặt secret ở đây; đổi giá trị thì phải build lại.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Tùy chọn: URL backend cho Server Components khi web chạy trong Docker
# (ví dụ http://api:4000/api). Để trống thì dùng NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
