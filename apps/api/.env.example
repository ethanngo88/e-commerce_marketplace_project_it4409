NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Số reverse proxy đứng trước API (production sau Caddy: 1). Để 0 khi không có proxy.
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace_dev
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/result

PAYMENT_EXPIRES_MINUTES=15
SHIPPING_FEE_PER_SELLER_ORDER=30000

# Tài khoản do `npx prisma db seed` tạo. Mật khẩu: 8–72 ký tự, có chữ và số.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# Mật khẩu chung của seller1, seller2, customer@example.com (chỉ dùng ở dev và test).
SEED_USER_PASSWORD=ChangeMe123!
